# Copy this file to .env and fill in real values. Never commit .env itself.

DJANGO_SECRET_KEY=replace-with-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave POSTGRES_DB unset to fall back to local SQLite (fastest way to start).
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Required for the Day 2 LLM investigation assistant. Not needed for Day 1.
GEMINI_API_KEY=
